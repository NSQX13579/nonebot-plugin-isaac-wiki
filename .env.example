# 以撒 wiki 插件配置（前缀 ISAAC_WIKI_）

# 无头浏览器（本地调试可设 false 观察渲染过程）
ISAAC_WIKI_HEADLESS=true

# 页面导航超时（秒）
ISAAC_WIKI_TIMEOUT=30

# 卡片宽度（像素，建议 720~820）
ISAAC_WIKI_CARD_WIDTH=760

# 交互
ISAAC_WIKI_RATE_LIMIT=3          # 同一人查询冷却（秒）
ISAAC_WIKI_MENU_TTL=60           # 直发数字的有效期（秒）
ISAAC_WIKI_QUOTE_TTL=1800        # 引用菜单消息的有效期（秒）
ISAAC_WIKI_QUEUE_LIMIT=3         # 渲染排队上限

# 缓存
ISAAC_WIKI_CACHE_MB=500          # 卡片缓存总量上限（MB）
ISAAC_WIKI_CACHE_TTL_DAYS=7      # 缓存有效期（天）

# 浏览器
ISAAC_WIKI_IDLE_CLOSE_MINUTES=10 # 空闲多久关掉浏览器

# 浏览器与接口走代理（wiki 的 Cloudflare 拦服务器 IP 时用），如 http://127.0.0.1:7890
ISAAC_WIKI_PROXY=

# 用真浏览器内核（装过 Chrome/Edge 时填 chrome / msedge），比自带 chromium 更容易过 Cloudflare
ISAAC_WIKI_CHANNEL=
